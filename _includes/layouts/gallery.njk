<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("GIUJUTSUS'S ART SHRINE :: 1996 - 2026") }}</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap" rel="stylesheet">
    <link href="/assets/gallery.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <header class="site-header win-box">
            <div class="win-titlebar">
                <span><i class="fa-solid fa-paintbrush"></i> C:\GIUJUTSUS\ARCHIVE\2016_2026.EXE</span>
                <div class="win-titlebar-controls">
                    <div class="win-title-btn">_</div>
                    <div class="win-title-btn">□</div>
                    <div class="win-title-btn" style="color: red;">X</div>
                </div>
            </div>

            <div class="nav-toolbar">
                <a href="/home/art/gallery/" class="win-btn {% if page.url == '/' %}active{% endif %}">
                    <i class="fa-solid fa-floppy-disk"></i> Archive
                </a>
                <a href="/home/art/gifts/" class="win-btn {% if page.url == '/gifts/' %}active{% endif %}">
                    <i class="fa-solid fa-gift" style="color: #ff00aa;"></i> Fanart & Gifts
                </a>
                <a href="/home/art/commissions/" class="win-btn {% if page.url == '/commissions/' %}active{% endif %}">
                    <i class="fa-solid fa-coins" style="color: #00aa00;"></i> Commissions
                </a>
                <a href="/home/art/usage/" class="win-btn {% if page.url == '/usage/' %}active{% endif %}">
                    <i class="fa-solid fa-shield-halved" style="color: #aa5500;"></i> Art Usage
                </a>
                 <a href="/home/main/" class="win-btn {% if page.url == '/usage/' %}active{% endif %}">
                    <i class="fa-solid fa-house" style="color: #3359ff;"></i> Go Back Home
                </a>
                <div style="margin-left: auto; display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 10px; font-weight: bold;" class="blink">!!! ONLINE !!!</span>
                    <span class="retro-counter">0012345</span>
                </div>
            </div>
        </header>

        <div class="retro-marquee">
            <marquee behavior="scroll" direction="left" scrollamount="6">
                WELCOME TO GIUJUTSUS'S DIGITAL ART ARCHIVE (2016-2026) ::: COMMISSIONS OPEN :::
            </marquee>
        </div>

        <main>
            {{ content | safe }}
        </main>

        <!-- Footer -->
        <footer class="site-footer win-box">
            <p>&copy; 2024-4EVR! <strong>Giujutsus Art Shrine</strong>. Built with Eleventy (11ty).</p>
        </footer>
    </div>
</body>
</html>
